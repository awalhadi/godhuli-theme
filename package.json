{
  "name": "godhuli-theme",
  "displayName": "Godhuli Theme — Warm Eye Comfort",
  "description": "Warm, eye-comfort dark & light theme for VS Code: low blue light, OLED Night, soft Mist, paper Light. Colorblind-safe, borderless, APCA-tuned.",
  "icon": "images/icon.png",
  "version": "0.2.0",
  "publisher": "NotifyX",
  "license": "MIT",
  "pricing": "Free",
  "preview": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/awalhadi/godhuli-theme.git"
  },
  "bugs": {
    "url": "https://github.com/awalhadi/godhuli-theme/issues"
  },
  "homepage": "https://github.com/awalhadi/godhuli-theme#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color theme",
    "dark theme",
    "light theme",
    "eye comfort",
    "eye strain",
    "low contrast",
    "soft",
    "warm",
    "warm dark",
    "low blue light",
    "night",
    "oled",
    "sepia",
    "paper",
    "accessible",
    "colorblind",
    "color blind",
    "semantic highlighting",
    "borderless",
    "minimal",
    "modern",
    "clean",
    "earth tones",
    "low light",
    "comfortable",
    "dim",
    "brown",
    "godhuli",
    "dusk"
  ],
  "galleryBanner": {
    "color": "#1D1B19",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "id": "Godhuli Dark",
        "label": "Godhuli Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/godhuli-dark.json"
      },
      {
        "id": "Godhuli Night",
        "label": "Godhuli Night",
        "uiTheme": "vs-dark",
        "path": "./themes/godhuli-night.json"
      },
      {
        "id": "Godhuli Mist",
        "label": "Godhuli Mist",
        "uiTheme": "vs-dark",
        "path": "./themes/godhuli-mist.json"
      },
      {
        "id": "Godhuli Light",
        "label": "Godhuli Light",
        "uiTheme": "vs",
        "path": "./themes/godhuli-light.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "docs": "node scripts/check.mjs --docs",
    "vscode:prepublish": "bun run build && bun run check",
    "package": "npx @vscode/vsce package",
    "publish:vscode": "npx @vscode/vsce publish",
    "publish:ovsx": "npx ovsx publish",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "shiki": "3.13.0"
  }
}
