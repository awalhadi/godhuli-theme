{% comment %}
  Product main section.
  TODO: replace the variant <select> with swatches once metafields are populated.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
  assign savings = current_variant.compare_at_price | minus: current_variant.price
-%}

<section class="product{% if on_sale %} product--sale{% endif %}" data-product-id="{{ product.id }}">
  <div class="product__media">
    {%- for media in product.media limit: 6 -%}
      {{ media | image_url: width: 1200 | image_tag: loading: 'lazy', alt: media.alt | escape }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endfor -%}
  </div>

  <div class="product__info">
    <h1>{{ product.title | escape }}</h1>
    <p class="vendor">{{ product.vendor | link_to_vendor }}</p>

    <p class="price">
      {{ current_variant.price | money_with_currency }}
      {% if on_sale %}
        <s>{{ current_variant.compare_at_price | money }}</s>
        <span class="badge">{{ 'products.save_amount' | t: amount: savings | money }}</span>
      {% endif %}
    </p>

    {% form 'product', product, id: 'product-form', novalidate: 'novalidate' %}
      <select name="id">
        {% for variant in product.variants %}
          <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}
            {%- if variant == current_variant %} selected{% endif %}>
            {{ variant.title }} &ndash; {{ variant.price | money }}
          </option>
        {% endfor %}
      </select>
      <input type="number" name="quantity" value="1" min="1"
        max="{{ current_variant.inventory_quantity | at_most: 10 }}">
      <button type="submit" {% if current_variant.available == false %}disabled{% endif %}>
        {{ 'products.add_to_cart' | t | default: 'Add to cart' }}
      </button>
    {% endform %}

    {% case product.type %}
      {% when 'Gift Card' %}
        <p>Delivered instantly by email.</p>
      {% else %}
        <p>Ships in {{ product.metafields.shipping.lead_days.value | default: 3 }} days.</p>
    {% endcase %}

    {% render 'product-tags', tags: product.tags, max: 5 %}
    <div class="rte">{{ product.description }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Product main",
  "settings": [{ "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true }]
}
{% endschema %}
