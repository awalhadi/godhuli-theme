{
  "name": "@godhuli/storefront",
  "version": "2.4.1",
  "private": true,
  "description": "Headless storefront for Godhuli Goods",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Godhuli Studio <dev@example.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/example/storefront.git"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.3",
  "main": "./dist/server.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "!dist/**/*.map"],
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.11",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "husky": "^9.1.6",
    "prettier": "3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"]
  },
  "browserslist": ["> 0.5%", "last 2 versions", "not dead"],
  "sideEffects": false
}
