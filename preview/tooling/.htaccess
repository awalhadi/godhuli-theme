# Godhuli Shop — Apache front controller & hardening
Options -Indexes +FollowSymLinks
DirectoryIndex index.php index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /errors/404.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS and strip "www."
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://godhuli.shop%{REQUEST_URI} [L,R=301]

    # Legacy order URLs: /order.php?id=123 -> /orders/123
    RewriteCond %{QUERY_STRING} (?:^|&)id=(\d+)(?:&|$)
    RewriteRule ^order\.php$ /orders/%1? [L,R=301]

    # Block dotfiles except .well-known
    RewriteRule (^|/)\.(?!well-known/) - [F]

    # Send everything else to the front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By

    <FilesMatch "\.(css|js|woff2|svg|webp)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

<Files ".env">
    Require all denied
</Files>
