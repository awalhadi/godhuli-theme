# Godhuli Shop — environment template
# Copy to .env and fill in real values. Never commit .env!

# --- Application -----------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME="Godhuli Shop"
APP_URL=http://localhost:${PORT}
LOG_LEVEL=debug   # trace | debug | info | warn | error

# --- Database --------------------------------------------
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/shop"

# --- Cache -----------------------------------------------
export REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# --- Payments --------------------------------------------
BKASH_APP_KEY=
BKASH_APP_SECRET=
STRIPE_SECRET_KEY='sk_test_replace_me'
WEBHOOK_SIGNING_SECRET="whsec_replace_me"

# --- Features --------------------------------------------
FEATURE_GIFT_MESSAGES=true
FEATURE_PARTIAL_REFUNDS=false
MAX_ITEMS_PER_ORDER=50
TAX_RATE=0.075

# --- Email -----------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
MAIL_FROM="Godhuli Shop <orders@godhuli.shop>"
ORDER_CONFIRMATION_SUBJECT="Your order #{orderId} is confirmed!\nThank you."
