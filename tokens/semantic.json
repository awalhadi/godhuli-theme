{
  "$comment": "semanticTokenColors: selector -> role, or { role?, fontStyle? | bold/italic/underline/strikethrough }. Omit role to keep the token color. Prefer the boolean flags: a fontStyle string also switches the other styles off, which blocks modifiers like *.mutable from composing; fontStyle '' is only for deliberately clearing TextMate styles. Mirrors syntax.json: interfaces/traits italic, declarations bold, generics use type-param.",

  "namespace": "namespace",
  "module": "namespace",

  "type": "type",
  "type.declaration": { "role": "type", "bold": true },
  "type.defaultLibrary": "type-builtin",
  "class": "type",
  "class.declaration": { "role": "type", "bold": true },
  "class.defaultLibrary": "type-builtin",
  "class.builtin": "type-builtin",
  "interface": { "role": "type", "italic": true },
  "interface.declaration": { "role": "type", "bold": true, "italic": true },
  "interface.defaultLibrary": "type-builtin",
  "enum": "type",
  "enum.declaration": { "role": "type", "bold": true },
  "struct": "type",
  "struct.declaration": { "role": "type", "bold": true },
  "union": "type",
  "typeAlias": "type",
  "typeAlias.declaration": { "role": "type", "bold": true },
  "typeParameter": { "role": "type-param", "fontStyle": "" },
  "builtinType": "type-builtin",
  "trait": { "role": "type", "italic": true },
  "trait.declaration": { "role": "type", "bold": true, "italic": true },

  "function": "function",
  "function.defaultLibrary": "function-builtin",
  "function.builtin": "function-builtin",
  "magicFunction": { "role": "function-builtin", "italic": true },
  "method": "method",
  "method.defaultLibrary": "function-builtin",
  "method.builtin": "function-builtin",
  "method.static": { "role": "method", "italic": true },
  "macro": "macro",
  "decorator": "macro",
  "function.decorator": "macro",
  "method.decorator": "macro",
  "class.decorator": "macro",
  "class.builtin.decorator": "macro",
  "decorator:php": "string-interp",
  "attribute": "macro",
  "derive": "macro",
  "builtinAttribute": "macro",

  "variable": "variable",
  "variable.defaultLibrary": "variable-builtin",
  "variable.readonly.defaultLibrary": "variable-builtin",
  "variable.static": { "role": "variable", "italic": true },
  "variable.readonly": "constant",
  "variable.readonly.local": "variable",
  "variable.builtin": "variable-builtin",
  "const": "constant",
  "const.constant": "constant",
  "parameter": "parameter",
  "parameter.declaration": { "role": "parameter", "italic": true },
  "selfKeyword": { "role": "keyword", "italic": true },
  "selfParameter": { "role": "keyword", "italic": true },
  "clsParameter": { "role": "keyword", "italic": true },
  "selfParameter.declaration": { "role": "keyword", "italic": true },
  "clsParameter.declaration": { "role": "keyword", "italic": true },
  "selfTypeKeyword": "type",
  "property": "property",
  "property.defaultLibrary": "variable-builtin",
  "property.static": { "role": "property", "italic": true },
  "enumMember": "constant",
  "constParameter": "constant",
  "event": "macro",
  "label": "constant",
  "lifetime": { "role": "keyword", "italic": true },

  "keyword": "keyword",
  "keyword.controlFlow": "control",
  "keyword.unsafe": { "role": "error", "italic": true },
  "modifier": { "role": "keyword", "italic": true },
  "operator": "operator",
  "operator.controlFlow": "control",
  "comment": { "role": "comment", "italic": true },
  "comment.documentation": { "role": "comment-doc", "italic": true },
  "string": "string",
  "formatSpecifier": "string-interp",
  "escapeSequence": "constant",
  "string.escapeCharacter": "constant",
  "number": "number",
  "boolean": "number",
  "builtinConstant": "number",
  "regexp": "regexp",

  "*.deprecated": { "strikethrough": true },
  "*.mutable": { "underline": true },
  "unresolvedReference": { "role": "error", "underline": true }
}
