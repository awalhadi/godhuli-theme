{
  "$comment": "semanticTokenColors: selector -> role, or { role, fontStyle }. fontStyle may be '' to clear inherited styles.",

  "namespace": "namespace",
  "module": "namespace",

  "type": "type",
  "type.declaration": { "role": "type", "fontStyle": "bold" },
  "type.defaultLibrary": "type-builtin",
  "class": "type",
  "class.declaration": { "role": "type", "fontStyle": "bold" },
  "class.defaultLibrary": "type-builtin",
  "interface": "type",
  "interface.declaration": { "role": "type", "fontStyle": "bold" },
  "interface.defaultLibrary": "type-builtin",
  "enum": "type",
  "enum.declaration": { "role": "type", "fontStyle": "bold" },
  "struct": "type",
  "struct.declaration": { "role": "type", "fontStyle": "bold" },
  "union": "type",
  "typeAlias": "type",
  "typeAlias.declaration": { "role": "type", "fontStyle": "bold" },
  "typeParameter": "type",
  "builtinType": "type-builtin",
  "trait": "type",
  "trait.declaration": { "role": "type", "fontStyle": "bold" },

  "function": "function",
  "function.defaultLibrary": "function-builtin",
  "method": "method",
  "method.defaultLibrary": "function-builtin",
  "method.static": { "role": "method", "fontStyle": "italic" },
  "macro": "macro",
  "decorator": "macro",
  "attribute": "macro",
  "derive": "macro",

  "variable": "variable",
  "variable.defaultLibrary": "variable-builtin",
  "variable.readonly.defaultLibrary": "variable-builtin",
  "variable.static": { "role": "variable", "fontStyle": "italic" },
  "parameter": "parameter",
  "parameter.declaration": { "role": "parameter", "fontStyle": "italic" },
  "selfKeyword": { "role": "keyword", "fontStyle": "italic" },
  "selfParameter": { "role": "keyword", "fontStyle": "italic" },
  "selfTypeKeyword": "type",
  "property": "property",
  "property.defaultLibrary": "variable-builtin",
  "property.static": { "role": "property", "fontStyle": "italic" },
  "enumMember": "constant",
  "event": "macro",
  "label": "constant",
  "lifetime": { "role": "keyword", "fontStyle": "italic" },

  "keyword": "keyword",
  "keyword.controlFlow": "control",
  "modifier": { "role": "keyword", "fontStyle": "italic" },
  "operator": "operator",
  "comment": { "role": "comment", "fontStyle": "italic" },
  "comment.documentation": { "role": "comment-doc", "fontStyle": "italic" },
  "string": "string",
  "formatSpecifier": "string-interp",
  "escapeSequence": "constant",
  "number": "number",
  "boolean": "number",
  "builtinConstant": "number",
  "regexp": "regexp",

  "*.deprecated": { "role": "fg-muted", "fontStyle": "strikethrough" },
  "unresolvedReference": { "role": "error", "fontStyle": "underline" }
}
